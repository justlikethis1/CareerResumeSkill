\documentclass[11pt,a4paper]{article}
\usepackage{fontspec}
<% if contains_cjk %>\IfFontExistsTF{Noto Sans CJK SC}{\setmainfont{Noto Sans CJK SC}}{%
\IfFontExistsTF{Microsoft YaHei}{\setmainfont{Microsoft YaHei}}{\PackageError{career-resume-skill}{CJK font unavailable}{Install Noto Sans CJK SC or Microsoft YaHei}}}
<% else %>\setmainfont{DejaVu Serif}<% endif %>
\usepackage{microtype}
\emergencystretch=3em
\hyphenpenalty=10000
\exhyphenpenalty=10000
\usepackage[hidelinks]{hyperref}
<% if compact == 0 %>\usepackage[margin=0.75in]{geometry}<% elif compact == 1 %>\usepackage[margin=0.68in]{geometry}<% else %>\usepackage[margin=0.60in]{geometry}<% endif %>
\pagestyle{empty}
\setlength{\parindent}{0pt}
\setlength{\parskip}{<% if compact == 0 %>9<% else %>6<% endif %>pt}
\begin{document}
\begin{flushright}
{\Large\bfseries << name >>}\\[0.25em]
{\small <% if contact.get('email') %><< contact.email >><% endif %><% if contact.get('phone') %> $\vert$ << contact.phone >><% endif %><% if contact.get('location') %> $\vert$ << contact.location >><% endif %>}
\end{flushright}
\vspace{-0.6em}
\begin{flushleft}
{\bfseries Date:} << date >>\\[0.45em]
{\bfseries To:} << recipient_title >>\\
<< company_name >>
\end{flushleft}

\vspace{0.25em}
{\large\bfseries << subject_line >>}\\[-0.25em]
\rule{\textwidth}{0.4pt}
\vspace{0.35em}

<< salutation >>

<% for paragraph in paragraphs %><< paragraph >>

<% endfor %><< closing >>,\\
\vspace{22pt}%
\csname textbf\endcsname{<< name >>}<% if contact.get('linkedin') or contact.get('github') %>\\
{\small <% if contact.get('linkedin') %>\href{<< contact.linkedin >>}{LinkedIn}<% endif %><% if contact.get('linkedin') and contact.get('github') %> $\vert$ <% endif %><% if contact.get('github') %>\href{<< contact.github >>}{GitHub}<% endif %>}<% endif %>
\end{document}
