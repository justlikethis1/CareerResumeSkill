# REQUIRED only for DeepSeek-powered JD enhancement, resume rewriting,
# and model-generated cover letters. Leave blank for deterministic offline mode.
DEEPSEEK_API_KEY=
# Optional: use a compatible local gateway instead of DeepSeek cloud.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
CAREER_SKILL_OUTPUT_DIR=output
# Optional explicit executable overrides; PATH/platform discovery remains the fallback.
LIBREOFFICE_PATH=
TECTONIC_PATH=
MICROSOFT_WORD_PATH=
# Maximum wait for Microsoft Word COM before falling back to LibreOffice (1-180 seconds).
CAREER_SKILL_WORD_CONVERSION_TIMEOUT_SECONDS=60
# Optional: explicitly expose a validated personal Master CV as cv://master_cv.json.
# Leave blank to expose only the empty template.
CAREER_SKILL_MASTER_CV_PATH=
# Optional private cache of PDF-verified tailored payloads; contains resume text.
# Use a private directory outside shared mounts; leave blank to disable persistence.
CAREER_SKILL_VERIFIED_CACHE_DIR=
# stdio is safest for local MCP clients; HTTP binds to loopback unless configured otherwise.
CAREER_SKILL_MCP_TRANSPORT=stdio
CAREER_SKILL_MCP_HOST=127.0.0.1
CAREER_SKILL_MCP_PORT=8000
